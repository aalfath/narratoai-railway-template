{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
	log {
		output stdout
		level WARN
	}
}

:{$PORT:8080} {
	# Open health path for Railway: answers only when Streamlit does.
	handle /healthz {
		rewrite * /_stcore/health
		reverse_proxy 127.0.0.1:8501
	}

	# Everything else (web UI, websocket, uploads) needs the generated login.
	handle {
		basic_auth {
			{$NARRATOAI_USERNAME} {$NARRATOAI_PASSWORD_HASH}
		}
		reverse_proxy 127.0.0.1:8501 {
			flush_interval -1
		}
	}
}
